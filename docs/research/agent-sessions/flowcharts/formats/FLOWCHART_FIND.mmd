flowchart LR
  I1["what is in this directory?"]:::intent
  I2["where is the file named / ending in X?"]:::intent
  C1["ls [-la] #lt;dir#gt; (45.8% of discovery; -la 39.6%, bare 49.1%)"]:::cmd
  C2["find #lt;dir#gt; -name '*.ext' -type f (27.7%; -name '*.ext' 40.0%, exact 19.4%, '*substr*' 17.3%)"]:::cmd
  C3["glob tool '**/*substr*', 'dir/**/*.ext', '**/Name.ext' (24.3%)"]:::cmd
  PP["#124; head -N (find 15.8%, ls 14.3% of chains; N = 20, 10, 30); #124; grep name filter; #124; wc -l"]:::post
  O1["bare names (24.2%)"]:::out
  O2["absolute paths (18.3%) / relative (6.4%)"]:::out
  O3["tool list 'Found N files' + paths (16.2%)"]:::out
  O4["ls -l long listing (13.2%)"]:::out
  O5["empty (13.3%)"]:::out
  SAT["head saturated in 52.6% of head-limited finds"]:::post
  N1["after saturation: find again 36.0%, read 25.2%, search 20.2%"]:::next
