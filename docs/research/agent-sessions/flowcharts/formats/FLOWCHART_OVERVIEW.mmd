flowchart LR
  subgraph WANT["what the model asks for / writes for itself"]
  W1["numbered lines 'N: text' (self-authored top skeleton; every harness read tool numbers lines)"]:::next
  W2["occurrences as path:line:text, one file (58.6% of greps) or one dir, capped by head -20/-10/-30"]:::next
  W3["context around a hit: ~9 lines above, ~26 below"]:::next
  W4["labelled sections: '=== label ===' / 'Label:' between probes"]:::next
  W5["counts first: 'w: {count}', grep -c, wc -l"]:::next
  W6["flat path lists (find/ls/glob)"]:::next
  end
  subgraph GET["what comes back today"]
  G1["shell: raw sed/cat lines with no numbers (27.4% of reads)"]:::out
  G2["empty greps 12.2%; head-limited greps saturated 29.9%"]:::out
  G3["codegraph node/explore: JSON, 'source' as one escaped string + startLine"]:::cg
  G4["codegraph search: definitions only (name, kind, file, line, signature)"]:::cg
  G5["codegraph callers/impact/tests: markdown lists; files: dir -#gt; symbolCount JSON"]:::cg
  end
  W1 -->|"no inline numbers"| G3
  W1 -->|"sed -n drops them"| G1
  W2 -->|"no usage lines, no scope"| G4
