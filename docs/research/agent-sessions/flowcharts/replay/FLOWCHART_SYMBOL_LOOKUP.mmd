flowchart LR
  P(["Symbol lookup / where is X<br/>n=28 episodes, 11 projects"])
  subgraph AGENT["Agent actual path: median 20 nav calls, 70 KB"]
    direction TB
    A1["grep x9.4"]
    A2["glob / ls / find x1.4"]
    A3["read x12.4<br/>of which re-reads x4.2"]
    A1 --> A2 --> A3
    A3 -. reformulate, open next file .-> A1
  end
  AR{{"agent saw 0.67 of ground-truth files<br/>read precision 0.46<br/>+3.5 calls outside the index root"}}
  subgraph CG["codegraph brief path: median 2 calls, 37 KB"]
    direction TB
    C1["explore(prompt terms)<br/>19 KB · recall 0.28"]
    C2["search(query + symbols batch)<br/>cum 37 KB · recall 0.48"]
    C1 --> C2
  end
  CR{{"codegraph surfaced 0.48<br/>precision 0.05"}}
  MP["same steps 1:1 via node/search/files<br/>median 20 calls, 138 KB<br/>recall 0.86"]
  OR["oracle explore (answer symbols)<br/>14 KB · recall 0.35"]
  MISS["missed files, why:<br/>1 graph hop from a surfaced file: 25<br/>no term or edge links it: 7<br/>reference left unresolved: 3"]
  P --> A1
  A3 --> AR
  AR -. substitute each call .-> MP
  P --> C1
  C2 --> CR
  CR -.-> MISS
  CR -. perfect terms .-> OR
  classDef agent fill:#fde2c8,stroke:#b35c00,color:#000
  classDef cg fill:#d6ecff,stroke:#1f5fa8,color:#000
  classDef res fill:#eeeeee,stroke:#555,color:#000
  class A1,A2,A3,MP agent
  class C1,C2 cg
  class AR,CR,OR,MISS res
