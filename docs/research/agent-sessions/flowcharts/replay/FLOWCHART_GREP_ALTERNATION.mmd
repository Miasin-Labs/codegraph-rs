flowchart LR
  P(["Grep-alternation batches<br/>n=28 episodes, 11 projects"])
  subgraph AGENT["Agent actual path: median 23 nav calls, 68 KB"]
    direction TB
    A1["grep x11.5"]
    A2["glob / ls / find x2.8"]
    A3["read x12.8<br/>of which re-reads x5.6"]
    A4["codegraph x0.1 · lsp x0.5"]
    A1 --> A2 --> A3 --> A4
    A3 -. reformulate, open next file .-> A1
  end
  AR{{"agent saw 0.79 of ground-truth files<br/>read precision 0.53<br/>+3.8 calls outside the index root"}}
  subgraph CG["codegraph brief path: median 2 calls, 38 KB"]
    direction TB
    C1["explore(prompt terms)<br/>19 KB · recall 0.41"]
    C2["search(query + symbols batch)<br/>cum 38 KB · recall 0.52"]
    C1 --> C2
  end
  CR{{"codegraph surfaced 0.52<br/>precision 0.07"}}
  MP["same steps 1:1 via node/search/files<br/>median 21 calls, 134 KB<br/>recall 0.92"]
  OR["oracle explore (answer symbols)<br/>18 KB · recall 0.52"]
  MISS["missed files, why:<br/>1 graph hop from a surfaced file: 45<br/>file has no symbols (config/docs): 41<br/>no term or edge links it: 6"]
  P --> A1
  A4 --> AR
  AR -. substitute each call .-> MP
  P --> C1
  C2 --> CR
  CR -.-> MISS
  CR -. perfect terms .-> OR
  classDef agent fill:#fde2c8,stroke:#b35c00,color:#000
  classDef cg fill:#d6ecff,stroke:#1f5fa8,color:#000
  classDef res fill:#eeeeee,stroke:#555,color:#000
  class A1,A2,A3,A4,MP agent
  class C1,C2 cg
  class AR,CR,OR,MISS res
