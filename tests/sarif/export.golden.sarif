{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "codegraph",
          "semanticVersion": "0.0.0-test",
          "rules": [
            {
              "id": "java-sqli-taint",
              "name": "java-sqli-taint",
              "shortDescription": {
                "text": "SQL built from request input"
              },
              "fullDescription": {
                "text": "A request parameter reaches SQL text unsanitized."
              },
              "help": {
                "text": "A request parameter reaches SQL text unsanitized."
              },
              "properties": {
                "tags": [
                  "CWE-89",
                  "taint",
                  "external/cwe/cwe-089"
                ],
                "security-severity": "7.5",
                "detector": "rule"
              }
            },
            {
              "id": "java-catch-generic-exception",
              "name": "java-catch-generic-exception",
              "shortDescription": {
                "text": "java-catch-generic-exception (Lint: a syntactic bug shape)"
              },
              "properties": {
                "detector": "lint"
              }
            },
            {
              "id": "codeql::java/sql-injection",
              "name": "codeql::java/sql-injection",
              "shortDescription": {
                "text": "Query built from user-controlled sources"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-089"
                ],
                "precision": "high",
                "security-severity": "8.8",
                "detector": "codeql"
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "%SRCROOT%": {
          "uri": "file:///PROJECT/"
        }
      },
